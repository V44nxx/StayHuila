*.py[cod]
*$py.class
*.so

# Entornos Virtuales y Build
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/

# Configuraciones de IDE y Editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store

