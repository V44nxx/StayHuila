static/uploads/*
!static/uploads/.gitkeep
!static/uploads/comprobantes/
static/uploads/comprobantes/*
!static/uploads/comprobantes/.gitkeep

# Archivos de Pruebas y Scripts Temporales
scratch/
*.log
tmp/
temp/
