# ── 1. ARCHIVOS DE ENTORNO Y CLAVES PRIVADAS ───────────────────────────────
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# ── 2. CACHÉ DE PYTHON Y ARCHIVOS COMPILADOS ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ── 3. ENTORNOS VIRTUALES Y PAQUETES ──────────────────────────────────────
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/
node_modules/

# ── 4. CONFIGURACIONES DE EDITORES E IDEs ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.bak

# ── 5. BASES DE DATOS LOCALES Y COPIAS DE SEGURIDAD ───────────────────────
*.sqlite
*.sqlite3
*.db
*.sql.bak

# ── 6. ARCHIVOS SUBIDOS POR USUARIOS (IMÁGENES, COMPROBANTES DE PAGO) ─────
# Permitir imágenes iniciales de uploads en Git para despliegue en VPS
!static/uploads/
!static/uploads/*
# Ignorar comprobantes de pago privados subidos por usuarios
static/uploads/comprobantes/*
!static/uploads/comprobantes/.gitkeep

# ── 7. TEMPORALES Y LOGS ──────────────────────────────────────────────────
scratch/
*.log
tmp/
temp/

