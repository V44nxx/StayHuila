# ==============================================================================
# STAYHUILA - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# IMPORTANTE DE SEGURIDAD:
# 1. COPIA ESTE ARCHIVO A ".env" PARA TU ENTORNO LOCAL/PRODUCCIÓN.
# 2. NUNCA SUBASE EL ARCHIVO ".env" REAL AL REPOSITORIO GIT.
# 3. CAMBIA LAS CLAVES POR DEFECTO Y CONTRASENAS ANTES DE DESPLEGAR.
# ==============================================================================

# ── Configuración de Flask ──────────────────────────────────────────────────
# Genera una clave segura en terminal con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_32_caracteres

# ── Configuración de Base de Datos (MySQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=StayHuila

# ── Configuración de Integración Gemini AI (OCR y Traducción) ────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Configuración de Correo (Gmail SMTP / Notificaciones) ────────────────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── Configuración de Nequi Negocios ──────────────────────────────────────────
NEQUI_NEGOCIO_CELULAR=3112345678
NEQUI_NEGOCIO_NOMBRE=StayHuila Reservas
NEQUI_NEGOCIO_LINK=https://checkout.nequi.wompi.co/l/VPOS_mtLSaM

